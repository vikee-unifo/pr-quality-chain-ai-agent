# Copy to .env (cp .env.example .env) and fill in locally. .env is git-ignored; THIS file is committed,
# so never put a real key here. Placeholders only.
# The app loads pr-quality-chain/.env automatically on startup. Variables already exported in your shell win.
# PRQ_ENV_FILE=/path/to/other.env loads a different file; PRQ_ENV_FILE= (empty) disables loading.

# ---- Model provider ----
# "mock" (default): offline, scripted, free. "litellm": a real provider via LiteLLM (pip install -e '.[llm]').
# Commands only call a real model with --live (or via the API server), even when this says litellm.
LLM_PROVIDER=mock
# For litellm use "<provider>/<model>", e.g. anthropic/claude-sonnet-5-5, openai/gpt-5, gemini/gemini-3.8-flash
LLM_MODEL=mock-model
# Gemini example (uncomment both, set GEMINI_API_KEY below):
# LLM_PROVIDER=litellm
# LLM_MODEL=gemini/gemini-3.8-flash
# Provider keys: LiteLLM reads the provider's own variable. Set only the one you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional explicit key / endpoint (overrides the provider variable; e.g. a proxy or self-hosted gateway)
LLM_API_KEY=
LLM_BASE_URL=
# Limits: the settings of the first successful Gemini 3.8 Flash run. Gemini thinks before answering and sends
# nothing until done: calls took 19-85 s, so a 60 s timeout failed every call. Output used 1.4k-2.1k tokens
# (thinking counts toward LLM_MAX_OUTPUT_TOKENS). Worst case: 3 agents x LLM_MAX_ATTEMPTS requests.
LLM_TIMEOUT_S=180
LLM_MAX_OUTPUT_TOKENS=4000
LLM_MAX_ATTEMPTS=1
LLM_TOTAL_BUDGET_S=240
AGENT_TIMEOUT_S=210
# 1 = one request at a time (gentler on free-tier per-minute limits; slower)
MAX_PARALLEL_AGENTS=1
MAX_CONTEXT_CHARS=60000
# Mock only: JSON script of responses (see benchmark/cases/*/mock_responses.json)
MOCK_SCRIPT_PATH=

# ---- LiteLLM (set automatically by the app when unset; shown for explicit control) ----
# PRODUCTION: the app loads .env itself; this stops LiteLLM from also loading it on import.
LITELLM_MODE=PRODUCTION
# True: use LiteLLM's bundled price list instead of downloading it on import.
LITELLM_LOCAL_MODEL_COST_MAP=True
# ERROR: LiteLLM debug logs contain prompts. Do not lower outside private debugging.
LITELLM_LOG=ERROR

# ---- GitHub ----
# Fine-grained token. Read: Pull requests, Contents, Checks. Publishing also needs Pull requests: write.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_WEBHOOK_SECRET=
# Write operations are off unless this is true.
GITHUB_PUBLISH_ENABLED=false

# ---- App ----
DATABASE_PATH=pr_quality_chain.db
LOG_LEVEL=INFO